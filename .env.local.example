# Base da API consumida pelo NAVEGADOR (somente leitura/forms públicos)
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Base da API usada pelos Route Handlers no SERVIDOR (nunca exposta ao browser)
BACKEND_API_URL=http://localhost:8000/api

# Token de admin — DEVE ser igual ao ADMIN_API_TOKEN do Backend. Server-only (sem NEXT_PUBLIC_).
ADMIN_API_TOKEN=troque_por_um_token_forte
